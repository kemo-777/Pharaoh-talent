# Local development only. Never use these placeholders for a public deployment.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
APP_SECRET=local-development-secret-replace-before-use-123456789
# Leave DATABASE_URL blank for local JSON development storage, or set a local PostgreSQL URL.
DATABASE_URL=
PGSSL=disable
EMAIL_VERIFICATION_REQUIRED=false
# Production requires a real HTTPS PUBLIC_APP_URL, DATABASE_URL, and verified Resend sender.
PUBLIC_APP_URL=http://127.0.0.1:3000
RESEND_API_KEY=
MAIL_FROM=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=180
AUTH_RATE_LIMIT_PER_MINUTE=12
IDENTITY_RATE_LIMIT_PER_MINUTE=8
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=5000
MAX_REQUESTS_PER_SOCKET=1000
MAX_CONNECTIONS=2000
